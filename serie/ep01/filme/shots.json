nd":"narr","line":7},{"t0":26.99,"t1":29.03,"text":"Eu pedi pro slime, baixinho:","kind":"narr","line":8},{"t0":29.63,"t1":31.42,"text":"Morre logo, por favor.","kind":"whisper","line":9},{"t0":32.62,"t1":33.812,"text":"Caiu uma gosma.","kind":"narr","line":10},{"t0":33.812,"t1":35.56,"text":"Valia quatro centavos.","kind":"narr","line":10},{"t0":35.88,"t1":38.07,"text":"Pra sacar, são vinte reais.","kind":"narr","line":11},{"t0":38.07,"t1":39.53,"text":"Quinhentas gosmas.","kind":"narr","line":11},{"t0":39.85,"t1":40.706,"text":"Eu já sabia:","kind":"narr","line":12},{"t0":40.706,"t1":42.846,"text":"sessenta e cinco por cento é a","kind":"narr","line":12},{"t0":42.846,"t1":44.487,"text":"chance de soltar gosma,","kind":"narr","line":12},{"t0":44.487,"t1":45.7,"text":"não uma garantia.","kind":"narr","line":12},{"t0":46.02,"t1":49.2,"text":"Nos dez primeiros vieram só quatro. Continuei.","kind":"narr","line":13},{"t0":49.52,"t1":51.291,"text":"Fui vender. Eu já sabia:","kind":"narr","line":14},{"t0":51.291,"t1":53.505,"text":"quando todo mundo vende junto,","kind":"narr","line":14},{"t0":53.505,"t1":54.39,"text":"o preço cai.","kind":"narr","line":14},{"t0":54.71,"t1":56.004,"text":"À uma da tarde,","kind":"narr","line":15},{"t0":56.004,"t1":57.643,"text":"salão vazio. Vendi:","kind":"narr","line":15},{"t0":57.643,"t1":59.8,"text":"sessenta e oito centavos.","kind":"narr","line":15},{"t0":60.25,"t1":61.37,"text":"Esqueci o almoço.","kind":"narr","line":16},{"t0":62.17,"t1":63.637,"text":"Eu já sabia que a ponta do","kind":"narr","line":17},{"t0":63.637,"t1":65.5,"text":"galho anda mais rápido que a mão.","kind":"narr","line":17},{"t0":66.1,"t1":67.324,"text":"Segurei na base:","kind":"narr","line":18},{"t0":67.324,"t1":69.85,"text":"mais velocidade, cinco por golpe.","kind":"narr","line":18},{"t0":70.25,"t1":71.31,"text":"Mas o galho rachou.","kind":"narr","line":19},{"t0":71.91,"t1":72.867,"text":"Pôr do sol.","kind":"narr","line":20},{"t0":72.867,"t1":74.606,"text":"Slime trinta e oito.","kind":"narr","line":20},{"t0":74.606,"t1":76.78,"text":"Oito segundos, não treze.","kind":"narr","line":20},{"t0":77.18,"t1":78.25,"text":"Nível três.","kind":"narr","line":21},{"t0":78.57,"t1":79.558,"text":"Fila na Banca,","kind":"narr","line":22},{"t0":79.558,"t1":82.38,"text":"preço caindo. Guardei o resto pra manhã.","kind":"narr","line":22},{"t0":82.88,"t1":85.326,"text":"Carteira: sessenta e oito centavos.","kind":"narr","line":23},{"t0":85.326,"t1":87.212,"text":"Mochila: quarenta e quatro,","kind":"narr","line":23},{"t0":87.212,"t1":88.47,"text":"no preço da manhã.","kind":"narr","line":23},{"t0":88.92,"t1":90.853,"text":"Eu já ia sair quando chegou uma","kind":"narr","line":24},{"t0":90.853,"t1":93.66,"text":"carta: cinquenta reais por uma Gosma Dourada.","kind":"narr","line":24},{"t0":93.98,"t1":95.148,"text":"Só cai de noite,","kind":"narr","line":25},{"t0":95.148,"t1":96.826,"text":"em caverna nível cinco.","kind":"narr","line":25},{"t0":96.826,"t1":98.14,"text":"Vence amanhã cedo.","kind":"narr","line":25},{"t0":98.74,"t1":100.461,"text":"Se alguém aí diz que jogo não","kind":"narr","line":26},{"t0":100.461,"t1":102.42,"text":"paga, manda isso pra essa pessoa.","kind":"narr","line":26},{"t0":102.92,"t1":104.421,"text":"Você faria o quê?","kind":"narr","line":27},{"t0":104.421,"t1":106.804,"text":"A, arriscar a caverna hoje.","kind":"narr","line":27},{"t0":106.804,"t1":110.07,"text":"B, esperar e perder a carta. Comenta.","kind":"narr","line":27}]}