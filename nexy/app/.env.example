# Copie este arquivo para .env e preencha com os dados do seu projeto no Supabase
# (Project Settings > API). A chave "anon"/"publishable" é pública por natureza;
# a proteção dos dados vem das regras (RLS) do supabase/schema.sql.
# NUNCA coloque aqui a chave "service_role"/"secret".
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
